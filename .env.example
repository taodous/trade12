# Copier ce fichier vers .env et renseigner les clés du compte PAPER Alpaca.
# Clés disponibles sur https://app.alpaca.markets (section Paper Trading).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Facultatif : alertes sur le téléphone via l'application ntfy (https://ntfy.sh), sans compte.
# Choisir un nom long et imprévisible, puis s'y abonner dans l'application. Quiconque connaît
# ce nom peut lire les alertes.
NTFY_TOPIC=
